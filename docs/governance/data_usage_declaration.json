{
  "schema": "factorlab_star50_filter_lab_data_usage_v2",
  "effective_date": "2026-09-08",
  "policy": "docs/governance/DATA_USAGE_POLICY_V2.md",
  "subjects": [
    "000688.SH",
    "000852.SH"
  ],
  "roles": {
    "warmup": {
      "definition": "pre-2021 history used only when needed to initialize causal filters or rolling state",
      "scored": false
    },
    "development": {
      "date_start": "2021-01-01",
      "date_end": "2023-12-31",
      "detail_access": "open",
      "fit_allowed": true,
      "repeat_use": true,
      "fresh_oos": false
    },
    "validation": {
      "date_start": "2024-01-01",
      "date_end": "2026-08-21",
      "detail_access": "open_after_candidate_fit",
      "fit_allowed_for_candidate_under_test": false,
      "diagnostic_inspection_allowed": true,
      "may_inform_next_iteration": true,
      "repeat_use": true,
      "fresh_oos": false
    },
    "blackbox_v1": {
      "definition": "first_60_complete_trading_days_strictly_after_2026-08-21",
      "status": "pending_data",
      "exact_date_start": null,
      "exact_date_end": null,
      "required_complete_trading_days": 60,
      "detail_access": "forbidden",
      "fit_allowed": false,
      "repeat_use": true,
      "query_interface": "registered_aggregate_metrics_only",
      "first_query_may_be_one_shot_blind_oos": true,
      "later_queries_are_fresh_oos": false,
      "unblind_transition": "reclassify_to_validation_not_destroyed"
    }
  },
  "blackbox_forbidden_outputs": [
    "date_or_timestamp_rows",
    "year_month_week_day_breakdowns",
    "event_or_session_rows",
    "path_charts",
    "best_or_worst_examples",
    "top_contributors",
    "error_cases",
    "outcome_conditioned_feature_distributions",
    "unregistered_threshold_sweeps",
    "unregistered_posthoc_metrics",
    "reconstructable_hidden_artifacts"
  ],
  "historical_note": "Older sealed reports keep their original consumed/development/OOS wording as historical protocol evidence. This declaration governs future reuse and does not upgrade old claims.",
  "production_authority": false,
  "do_not_mix_with": [
    "factorlab-two-wave-strategy-lab",
    "factorlab-overnight-open-lab",
    "factorlab-multifactor-stock-lab"
  ]
}
